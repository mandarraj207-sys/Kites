diff --git a/test/optimizer/forwarding_instruction_scheduler_test.cpp b/test/optimizer/forwarding_instruction_scheduler_test.cpp
index 19cb6c1..2dec3f6 100644
--- a/test/optimizer/forwarding_instruction_scheduler_test.cpp
+++ b/test/optimizer/forwarding_instruction_scheduler_test.cpp
@@ -79,3 +79,21 @@ TEST(ForwardingSchedulerTest, CompressedBranchIsAlsoABarrier)
     ASSERT_EQ(result.instructions.size(), block.size());
     EXPECT_EQ(result.instructions[2].getOpcode(), "c.beqz");
 }
+
+TEST(ForwardingSchedulerTest, MovesBranchOperandProducerEarlier)
+{
+    std::vector<ICUnit> block = {
+        makeFwdInstruction(0, "sub", "x10", "x11", "x12"),
+        makeFwdInstruction(1, "xor", "x13", "x14", "x15"),
+        makeFwdInstruction(2, "add", "x26", "x25", "x0"),
+        makeFwdInstruction(3, "bne", "", "x26", "x0")};
+    block[3].setLabel("inner");
+
+    const auto result = scheduleForwardingBasicBlock(block);
+    ASSERT_EQ(result.instructions.size(), block.size());
+    EXPECT_EQ(result.instructions[0].getOpcode(), "add");
+    EXPECT_EQ(result.instructions[1].getOpcode(), "sub");
+    EXPECT_EQ(result.instructions[2].getOpcode(), "xor");
+    EXPECT_EQ(result.instructions[3].getOpcode(), "bne");
+    EXPECT_EQ(result.moved_instructions, 2u);
+}
